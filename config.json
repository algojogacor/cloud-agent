{
  "agents": {
    "defaults": {
      "model": "deepseek-chat",
      "provider": "deepseek",
      "workspace": "/app/data"
    }
  },
  "providers": {
    "deepseek": {
      "api_key": "${DEEPSEEK_API_KEY_1}"
    },
    "perplexity": {
      "api_key": "${PERPLEXITY_API_KEY_1}"
    },
    "groq": {
      "api_key": "${GROQ_API_KEY}"
    },
    "qwen": {
      "api_key": "${QWEN_API_KEY}"
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "token": "${TELEGRAM_BOT_TOKEN}",
      "enable_mention": true
    }
  },
  "gateway": {
    "host": "0.0.0.0",
    "port": 3000
  }
}
