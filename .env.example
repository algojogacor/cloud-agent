# LLM Providers
# Primary: DeepSeek
DEEPSEEK_API_KEY_1=sk-your-deepseek-key-1
DEEPSEEK_API_KEY_2=sk-your-deepseek-key-2
DEEPSEEK_API_KEY_3=sk-your-deepseek-key-3
DEEPSEEK_API_KEY_4=sk-your-deepseek-key-4
DEEPSEEK_API_KEY_5=sk-your-deepseek-key-5

# Perplexity
PERPLEXITY_API_KEY_1=pplx-your-perplexity-key-1
PERPLEXITY_API_KEY_2=pplx-your-perplexity-key-2

# Fallback providers
GROQ_API_KEY=gsk_your-groq-key-here
QWEN_API_KEY=sk-your-qwen-key-here

# Optional MCP integrations
BRAVE_API_KEY=your-brave-api-key-here
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-google-refresh-token

# Supabase
# Used for persisting the whole nanobot workspace in Storage, including WhatsApp auth.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=nanobot-private
SUPABASE_WORKSPACE_OBJECT=nanobot/workspace.zip
SUPABASE_SYNC_ROOT=/app/data
SUPABASE_SYNC_INTERVAL_SECONDS=300

# Optional for future Postgres-backed features or your own app code.
# If Koyeb cannot use the direct IPv6 connection, use the Supabase Session Pooler URI instead.
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# Nanobot
NANOBOT_WORKSPACE=/home/nanobot/.nanobot
